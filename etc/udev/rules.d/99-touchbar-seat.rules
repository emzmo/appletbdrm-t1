# Touch Bar multitouch digitizer: assign to seat1 (D-Bus safe, no hyphen)
# The daemon's libinput context uses udev_assign_seat("seat1") to find
# this device exclusively.
#
# The DRM card seat isolation is in 71-seat.rules (shadowed) because
# GOTO only works within the same rules file.
SUBSYSTEM=="input", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="8600", ENV{ID_SEAT}="seat1"